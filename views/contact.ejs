<%- include('partials/header', { title: 'Contact Us' }) %>

<div class="form-wrapper"> <%# Wrapper for consistent form styling %>
    <h1>Get In Touch</h1>

    <%# Display success or error messages %>
    <% if (locals.messageSent) { %>
        <p class="success-message">Thank you! Your message has been sent successfully. We'll get back to you if necessary.</p>
    <% } else if (locals.error) { %>
        <p class="error-message"><%= error %></p>
    <% } %>

    <%# Show the form only if the message hasn't been sent %>
    <% if (!locals.messageSent) { %>
        <p>Have questions or suggestions? Fill out the form below to reach us.</p>
        <form action="/contact" method="POST" class="contact-form">
            <div class="form-group">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" required>
            </div>
            <div class="form-group">
                <label for="email">Email:</label>
                <input type="email" id="email" name="email" required>
            </div>
            <div class="form-group">
                <label for="message">Message:</label>
                <textarea id="message" name="message" rows="6" required></textarea>
            </div>
            <button type="submit" class="btn">Send Message</button> <%# Use the .btn class %>
        </form>
    <% } %>
</div>

<%- include('partials/footer') %>